# ==============================================================================
# EASY RIDE — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit .env or .env.local to version control.
# In production (e.g. Vercel), populate these in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# ------------------------------------------------------------------------------
# 2. Firebase (User Auth, Session Management & Admin SDK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Server-Side)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_SESSION_SECRET=your_random_32_character_session_signing_secret

# ------------------------------------------------------------------------------
# 3. Google Gemini (Autonomous Ride Negotiation & Intent Routing)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Circle Developer-Controlled Wallets & Arc Testnet (Payment Infrastructure)
# ------------------------------------------------------------------------------
CIRCLE_API_KEY=TEST:apiKey:your_circle_test_key
CIRCLE_ENTITY_SECRET=your_32_byte_circle_entity_secret_hex
CIRCLE_WALLET_SET_ID=your_circle_wallet_set_uuid
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_DEPLOYER_PRIVATE_KEY=your_arc_deployer_private_key_optional
ESCROW_CONTRACT_ADDRESS=0xc966451619B6a30b1aF8Dd8364B2A79a7da2C447

# ------------------------------------------------------------------------------
# 5. Stripe (USD Wallet Top-ups & Card Processing)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_RESTRICTED_KEY=rk_test_your_stripe_restricted_key

# ------------------------------------------------------------------------------
# 6. Mapbox (Turn-by-turn Maps, Geospatial Routing & Geocoding)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# ------------------------------------------------------------------------------
# 7. Resend (Email Notifications & Receipts)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Easy Ride <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 8. HuggingFace / Fallback AI (Optional)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key
HF_TOKEN=hf_your_huggingface_token

# ------------------------------------------------------------------------------
# 9. Developer / Admin Overrides
# ------------------------------------------------------------------------------
DEV_EMAIL=admin@example.com
